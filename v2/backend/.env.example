# Copie para .env e ajuste. Nunca suba o .env para o git.
ENVIRONMENT=development

# Para testar no seu computador sem instalar nada, use SQLite (um arquivo local):
DATABASE_URL=sqlite:///./dev.db
# Para usar PostgreSQL (ex.: `docker compose up -d db`), troque pela linha abaixo:
# DATABASE_URL=postgresql+psycopg://financeiro:financeiro@localhost:5432/controle_financeiro

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-esta-chave-antes-de-publicar-o-app
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Endereços que podem chamar a API pelo navegador (o app web roda na porta 8080).
CORS_ORIGINS=["http://localhost:8080","http://localhost:3000"]

TRIAL_DAYS=14
BILLING_PROVIDER=mock

# Open Finance: mock (dados falsos) ou pluggy
OPEN_FINANCE_PROVIDER=mock
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
OPEN_FINANCE_WEBHOOK_SECRET=
